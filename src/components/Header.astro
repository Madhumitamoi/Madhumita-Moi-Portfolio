---
const { pathname = '/' } = Astro.props;
const links = [
  ['/work/', 'Work'],
  ['/projects/', 'Building'],
  ['/travel/', 'Travel'],
  ['/notes/', 'Notes'],
  ['/contact/', 'Contact'],
];
---
<header class="site-header">
  <a class="wordmark" href="/">Madhumita Moi</a>
  <nav aria-label="Primary navigation">
    {links.map(([href, label]) => (
      <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>
