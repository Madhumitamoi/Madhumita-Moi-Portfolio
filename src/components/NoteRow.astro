---
const { note } = Astro.props;
const date = note.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<article class="note-row">
  <time datetime={note.data.date.toISOString()}>{date}</time>
  <div>
    <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
    <p>{note.data.category} <span>·</span> {note.data.readTime}</p>
  </div>
  <a class="row-arrow" href={`/notes/${note.id}/`} aria-label={`Read ${note.data.title}`}>→</a>
</article>
